---
import GitHub from "./icons/GitHub.astro";
const personalImageAlt = ""
import LinkedInIcon from "../components/icons/LinkedIn.astro"
import MailIcon from "../components/icons/Mail.astro"
import SocialPill from "../components/SocialPill.astro"
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <a class:list="justify-content: left"
       href="https://linkedin.com/in/antonio-dev-b71146213"
       target="_blank"
       rel="noopener"
       class="flex items-center transition md:justify-center md:hover:scale-105"
    >
    </a>
  </div>
  <h1 class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white">Jose Antonio</h1>
  <h2 class="mt-3 text-2xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300"><strong>Desarrollador Web</strong></h2>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill
        href="mailto:antonioestudiante@gmail.com"
        class="flex items-center gap-2 px-6 py-2 bg-gradient-to-br from-indigo-500/15 to-purple-500/15 border border-indigo-500/30 rounded-xl text-gray-200 font-medium transition-all duration-300 backdrop-blur-sm shadow-lg hover:from-indigo-500/25 hover:to-purple-500/25 hover:-translate-y-0.5 hover:shadow-indigo-500/20 hover:shadow-2xl hover:border-indigo-500/40"
    >
      <MailIcon class="size-6" />
      <span class="text-sm">Correo</span>
    </SocialPill>
    <SocialPill
        href="https://www.linkedin.com/in/antonio-dev-b71146213"
        class="flex items-center gap-2 px-6 py-2 bg-gradient-to-br from-indigo-500/15 to-purple-500/15 border border-indigo-500/30 rounded-xl text-gray-200 font-medium transition-all duration-300 backdrop-blur-sm shadow-lg hover:from-indigo-500/25 hover:to-purple-500/25 hover:-translate-y-0.5 hover:shadow-indigo-500/20 hover:shadow-2xl hover:border-indigo-500/40"
    >
      <LinkedInIcon class="size-6" />
      <span class="text-sm">LinkedIn</span>
    </SocialPill>
    <SocialPill
        href="https://github.com/Anton-dev3306"
        class="flex items-center gap-2 px-6 py-2 bg-gradient-to-br from-indigo-500/15 to-purple-500/15 border border-indigo-500/30 rounded-xl text-gray-200 font-medium transition-all duration-300 backdrop-blur-sm shadow-lg hover:from-indigo-500/25 hover:to-purple-500/25 hover:-translate-y-0.5 hover:shadow-indigo-500/20 hover:shadow-2xl hover:border-indigo-500/40"
    >
      <GitHub class="size-6" />
      <span class="text-sm">Github</span>
    </SocialPill>
  </nav>
</div>