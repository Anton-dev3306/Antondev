---
import GitHub from "./icons/GitHub.astro"
import NextJS from "./icons/NextJS.astro"
import Tailwind from "./icons/Tailwind.astro"
import JavaScript from "./icons/JavaScript.astro"
import Link from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import RadixUI from "./icons/RadixUI.astro"
import ReactIcon from "./icons/React.astro"
import GoogleCloud from "./icons/GCloudIcon.astro"
import SpringBoot from "./icons/SpringIcon.astro"
import TwiloIcon from "./icons/TwilioIcon.astro"
import CloudinaryIcon from "./icons/CloudinaryIcon.astro"
const DEFAULT_CLASS = "bg-[#003159] text-white";
const BLACK_WHITE = "bg-black text-white";

const TAGS = {
    NEXT: { name: "Next.js", icon: NextJS, class: BLACK_WHITE},
    TAILWIND: { name: "Tailwind CSS", icon: Tailwind, class: DEFAULT_CLASS },
    JAVASCRIPT: { name: "JavaScript", icon: JavaScript, class: DEFAULT_CLASS },
    RADIXUI: { name: "Radix-UI", icon: RadixUI, class: DEFAULT_CLASS },
    REACT: { name: "React", icon: ReactIcon, class: DEFAULT_CLASS },
    GOOGLECLOUD: { name: "Google Cloud", icon: GoogleCloud, class: DEFAULT_CLASS },
    SPRINGBOOT: {name: "Spring boot", icon: SpringBoot, class: DEFAULT_CLASS },
    TWILO: {name: "Twilo", icon: TwiloIcon, class: DEFAULT_CLASS },
    CLOUDINARY: {name: "Cloudinary", icon: CloudinaryIcon, class: DEFAULT_CLASS },
}

const PROJECTS = [
    {
        title: "Bloom",
        description:
            "Aplicación de mensajería en tiempo real con soporte para chats privados y grupales, envío de imágenes, videos, audios y archivos, reacciones a mensajes, indicadores de presencia en línea, verificación de cuenta por SMS y gestión de contactos. Construida con Next.js, Spring Boot, WebSockets y almacenamiento en Cloudinary.",
        link: "https://bloom-frontend-smoky.vercel.app",
        github: "https://github.com/Anton-dev3306/Bloom-frontend",
        image: "/projects/Bloom.webp",
        tags: [TAGS.NEXT, TAGS.REACT, TAGS.TAILWIND, TAGS.SPRINGBOOT, TAGS.TWILO, TAGS.CLOUDINARY],
    },
    {
        title: "Email Cleaner",
        description:
            "Aplicacion de limpieza de email en la que puedes analizar todos los correos de tu bandeja de entrada" +
            ", obtener suscripciones activas y remitentes recurrentes, marcar spam masivamente por remitente o directamente marcar como spam todos los remitentes encontrados durante el analisis.",
        link: "https://app-emails-production.up.railway.app/",
        github: "https://github.com/Anton-dev3306/app-emails",
        image: "/projects/cleanGmail.webp",
        tags: [TAGS.REACT, TAGS.RADIXUI, TAGS.TAILWIND, TAGS.GOOGLECLOUD],
    },
    {
        title: "WebSketcher",
        description:
            "Extension de google que te permite dibujar y escribir sobre cualquier pagina web. +Todos los colores del RGB disponibles. +Cuadro de texto para insertar en cualquier pagina web. +Distintas figuras para insertar",
        link: "https://chromewebstore.google.com/detail/websketcher/jiflkkaikldbbnmbbpfijgdahjoaobho",
        image: "/projects/webSketcher.webp",
        tags: [TAGS.JAVASCRIPT],
    },
]
---

<div class="flex flex-col gap-y-16">
    {PROJECTS.map(({ image, title, description, tags, link, github }) => (
            <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
                <div class="w-full md:w-1/2">
                    <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
                        <img
                                alt={`Proyecto ${title}`}
                                class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
                                loading="lazy"
                                src={image}
                        />
                    </div>
                </div>

                <div class="w-full md:w-1/2 md:max-w-lg">
                    <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
                        {title}
                    </h3>

                    <ul class="flex flex-row flex-wrap mt-2 mb-2 gap-x-2">
                        {tags.map((tag) => {
                            const Icon = tag.icon;
                            return (
                                    <li>
                                <span class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-3 px-2`}>
                                    <Icon class="size-4" />
                                    {tag.name}
                                </span>
                                    </li>
                            );
                        })}
                    </ul>

                    <p class="mt-2 text-gray-700 dark:text-gray-400">
                        {description}
                    </p>

                    <footer class="flex items-end justify-start mt-4 gap-x-4">
                        {github && (
                                <LinkButton href={github}>
                                    <GitHub class="size-6" />
                                    Code
                                </LinkButton>
                        )}
                        {link && (
                                <LinkButton href={link}>
                                    <Link class="size-4" />
                                    Preview
                                </LinkButton>
                        )}
                    </footer>
                </div>
            </article>
    ))}
</div>


