---
import GitHub from "./icons/GitHub.astro"
import Link from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"

const EXPERIENCE = [
   {
    date: "Mayo 2025 - Actualidad",
    title: "Open Source Contributor",
    company: "QuoteVote",
    description:
        "Contribuí activamente en una plataforma social de código abierto construida con Node.js, Express, Apollo GraphQL y MongoDB en arquitectura monorepo. Identifiqué y resolví bugs en resolvers de GraphQL (null checks, field name mismatches, auth guards), corregí definiciones de esquema incompletas que causaban errores 400 en producción, y solucioné race conditions en la configuración de Docker. También trabajé en la estabilización del pipeline de CI/CD corrigiendo la configuración de GitHub Actions y errores de build en Railway.",
    github: "https://github.com/QuoteVote/quotevote-monorepo",
    link: "www.quote.vote",
    current: true,
},
    {
        date: "Mayo 2025 - Actualidad",
        title: "Open Source Contributor",
        company: "Beautifier.js",
        description:
            "Participé corrigiendo bugs relacionados con indentación en LESS y experiencia de usuario en el editor. Trabajé analizando el flujo interno del formateador y manteniendo consistencia entre implementaciones en JavaScript y Python.",
        github: "https://github.com/beautifier/js-beautify",
        link: "https://beautifier.io/",
        current: true,
    },
]
---

<div class="flex flex-col gap-y-12">
    {EXPERIENCE.map(({ date, title, company, description, github, link }) => (
        <article class="flex flex-col gap-y-3 border-l-2 border-green-500 pl-6">
            <span class="text-sm text-gray-500 dark:text-gray-400">
                {date}
            </span>

            <div>
                <h3 class="text-xl font-bold text-gray-800 dark:text-gray-100">
                    {title}
                </h3>

                <p class="text-green-600 dark:text-green-400 font-medium">
                    {company}
                </p>
            </div>

            <p class="text-gray-200 dark:text-gray-100">
                {description}
            </p>

            <footer class="flex items-center gap-x-4 pt-2">
                {github && (
                    <LinkButton href={github}>
                        <GitHub class="size-5" />
                        Repo
                    </LinkButton>
                )}

                {link && (
                    <LinkButton href={link}>
                        <Link class="size-4" />
                        Preview
                    </LinkButton>
                )}
            </footer>
        </article>
    ))}
</div>