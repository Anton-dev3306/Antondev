---
import NextJS from "./icons/NextJS.astro"
import Tailwind from "./icons/Tailwind.astro"
import JavaScript from "./icons/JavaScript.astro"
import React from "./icons/React.astro"
import Java from "./icons/Java.astro"
import SpringBoot from "./icons/SpringBoot.astro"
import PHP from "./icons/PHP.astro"
import GoogleCloud from "./icons/GCloudIcon.astro"
import N8N from "./icons/N8N.astro"
import Laravel from "./icons/Laravel.astro"
import MYSQL from "./icons/mysql.astro"
import Postgres from "./icons/Postgres.astro"
import AstroIcon from "./icons/AstroIcon.astro"
const TECHNOLOGIES = [
    { name: "Java", icon: Java, class: "bg-[#007396]/70 text-white" },
    { name: "PHP", icon: PHP, class: "bg-[#777BB4]/70 text-white" },
    { name: "JavaScript", icon: JavaScript, class: "bg-[#F7DF1E] text-black" },
    { name: "Next.js", icon: NextJS, class: "bg-black text-white" },
    { name: "React", icon: React, class: "bg-[#61DAFB]/70 text-black" },
    { name: "Tailwind CSS", icon: Tailwind, class: "bg-[#06B6D4]/70 text-white" },
    { name: "Astro", icon: AstroIcon, class: "bg-[#FF5D01]/70 text-white" },
    { name: "Laravel", icon: Laravel, class: "bg-[#FF233F]/70 text-white" },
    { name: "Spring Boot", icon: SpringBoot, class: "bg-[#6DB33F]/70 text-white" },
    { name: "MYSQL", icon: MYSQL, class: "bg-[#4479A1]/70 text-white" },
    { name: "Postgres", icon: Postgres, class: "bg-[#336791]/70 text-white" },
    { name: "Google Cloud", icon: GoogleCloud, class: "bg-[#4285F4]/70 text-white" },
    { name: "N8N", icon: N8N, class: "bg-[#EA4B71]/70 text-white" },
]

const TECH_LOOP = [...TECHNOLOGIES, ...TECHNOLOGIES]
---

<section class="w-full py-12 overflow-hidden">
    <div class="container mx-auto px-4">

        <div class="relative">
            <div class="absolute left-0 top-0 bottom-0 w-20 bg-gradient-to-r from-white dark:from-gray-950 to-transparent z-10"></div>
            <div class="absolute right-0 top-0 bottom-0 w-20 bg-gradient-to-l from-white dark:from-gray-950 to-transparent z-10"></div>

            <div class="tech-scroll-container">
                <div class="tech-scroll-track">
                    {TECH_LOOP.map((tech) => (
                            <div class={`tech-badge ${tech.class}`}>
                                <tech.icon class="size-6" />
                                <span class="font-semibold">{tech.name}</span>
                            </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .tech-scroll-container {
        overflow: hidden;
        position: relative;
        width: 100%;
    }

    .tech-scroll-track {
        display: flex;
        gap: 1rem;
        animation: scroll 30s linear infinite;
        width: fit-content;
    }

    .tech-badge {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        border-radius: 9999px;
        white-space: nowrap;
        flex-shrink: 0;
        font-size: 0.875rem;
    }

    @keyframes scroll {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }

    .tech-scroll-track:hover {
        animation-play-state: paused;
    }
</style>
