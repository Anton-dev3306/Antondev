---
import Code from "./icons/Code.astro"

const Skills = {
    frontend: [
        "HTML",
        "CSS", 
        "JavaScript",
        "React",
        "Next.js",
        "Astro",
        "Tailwind CSS"
    ],
    backend: [
        "Java",
        "Spring Boot",
        "Spring Security",
        "Hibernate",
        "Java EE",
        "PHP",
        "Laravel"
    ],
    tools: [
        "MySQL",
        "PostgreSQL",
        "Firebird",
        "Docker",
        "Git",
        "GitHub",
        "Postman",
        "Google Cloud",
        "n8n",
        "RabbitMQ",
        "JWT"
    ]
}
---

<article class="relative">
    <div class="mb-6">
        <h3 class="flex items-center gap-x-3 text-2xl font-semibold text-gray-800 dark:text-gray-100 mb-8">
            <Code class="size-7" />
            Mis skills
        </h3>
    </div>

    <div class="space-y-6">
        <!-- Frontend -->
        <div>
            <h4 class="text-sm font-semibold text-gray-600 dark:text-gray-400 mb-3">
                Lenguajes y Frameworks Frontend
            </h4>
            <div class="flex flex-wrap gap-2.5">
                {Skills.frontend.map((skill) => (
                    <span class="px-4 py-2 bg-white dark:bg-gray-800 border-2 border-gray-900 dark:border-gray-300 rounded-lg text-sm font-medium text-gray-900 dark:text-gray-100">
                        {skill}
                    </span>
                ))}
            </div>
        </div>

        <!-- Backend -->
        <div>
            <h4 class="text-sm font-semibold text-gray-600 dark:text-gray-400 mb-3">
                Backend
            </h4>
            <div class="flex flex-wrap gap-2.5">
                {Skills.backend.map((skill) => (
                    <span class="px-4 py-2 bg-white dark:bg-gray-800 border-2 border-gray-900 dark:border-gray-300 rounded-lg text-sm font-medium text-gray-900 dark:text-gray-100">
                        {skill}
                    </span>
                ))}
            </div>
        </div>

        <!-- Herramientas -->
        <div>
            <h4 class="text-sm font-semibold text-gray-600 dark:text-gray-400 mb-3">
                Habilidades y Herramientas Complementarias
            </h4>
            <div class="flex flex-wrap gap-2.5">
                {Skills.tools.map((skill) => (
                    <span class="px-4 py-2 bg-white dark:bg-gray-800 border-2 border-gray-900 dark:border-gray-300 rounded-lg text-sm font-medium text-gray-900 dark:text-gray-100">
                        {skill}
                    </span>
                ))}
            </div>
        </div>
    </div>
</article>