---
import Code from "./icons/Code.astro"

const Skills = {
    frontend: [
        "HTML",
        "CSS", 
        "JavaScript",
        "React",
        "Next.js",
        "Astro",
        "Tailwind CSS"
    ],
    backend: [
        "Java",
        "Spring Boot",
        "Spring Security",
        "Hibernate",
        "Java EE",
        "PHP",
        "Laravel"
    ],
    tools: [
        "MySQL",
        "PostgreSQL",
        "Firebird",
        "Docker",
        "Git",
        "GitHub",
        "Postman",
        "Google Cloud",
        "n8n",
        "RabbitMQ",
        "JWT"
    ]
}
---

<article class="p-6 bg-gray-100 dark:bg-gray-900 rounded-lg shadow-md">

    <div class="space-y-6">
        <!-- Frontend -->
        <div>
            <h2 class="text-sm font-semibold text-gray-600 dark:text-gray-400 mb-3">
                Frontend
            </h2>
            <div class="flex flex-wrap gap-2.5">
                {Skills.frontend.map((skill) => (
                    <span class="px-4 py-2 bg-white dark:bg-gray-800 border-2 border-gray-900 dark:border-gray-300 rounded-lg text-sm font-medium text-gray-900 dark:text-gray-100">
                        {skill}
                    </span>
                ))}
            </div>
        </div>

        <!-- Backend -->
        <div>
            <h2 class="text-sm font-semibold text-gray-600 dark:text-gray-400 mb-3">
                Backend
            </h2>
            <div class="flex flex-wrap gap-2.5">
                {Skills.backend.map((skill) => (
                    <span class="px-4 py-2 bg-white dark:bg-gray-800 border-2 border-gray-900 dark:border-gray-300 rounded-lg text-sm font-medium text-gray-900 dark:text-gray-100">
                        {skill}
                    </span>
                ))}
            </div>
        </div>

        <!-- Herramientas -->
        <div>
            <h2 class="text-sm font-semibold text-gray-600 dark:text-gray-400 mb-3">
                Habilidades y Herramientas Complementarias
            </h2>
            <div class="flex flex-wrap gap-2.5">
                {Skills.tools.map((skill) => (
                    <span class="px-4 py-2 bg-white dark:bg-gray-800 border-2 border-gray-900 dark:border-gray-300 rounded-lg text-sm font-medium text-gray-900 dark:text-gray-100">
                        {skill}
                    </span>
                ))}
            </div>
        </div>
    </div>
</article>