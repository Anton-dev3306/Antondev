---
import Code from "./icons/Code.astro"

const Skills = [
    // Frontend
    "HTML",
    "CSS",
    "JavaScript",
    "React",
    "Next.js",
    "Astro",
    "Tailwind CSS",

    // Backend
    "Java",
    "Spring Boot",
    "Spring Security",
    "Hibernate",
    "Java EE",
    "PHP",
    "Laravel",

    // Herramientas
    "MySQL",
    "PostgreSQL",
    "Firebird",
    "Docker",
    "Git",
    "GitHub",
    "Postman",
    "Google Cloud",
    "n8n",
    "RabbitMQ",
    "JWT"
]
---

<article class="relative">
    <div class="mb-6">
        <h3 class="flex items-center gap-x-3 text-2xl font-semibold text-gray-800 dark:text-gray-100 mb-8">
            <Code class="size-7" />
            Mis skills
        </h3>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
        {Skills.map((skill) => (
            <span
                class="px-4 py-2 bg-white dark:bg-gray-800 border-2 border-gray-900 dark:border-gray-300 rounded-lg text-sm font-medium text-gray-900 dark:text-gray-100 text-center transition-transform duration-200 hover:scale-105"
            >
                {skill}
            </span>
        ))}
    </div>
</article>